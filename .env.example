# ==========================================
# AI PROVIDER CONFIGURATION
# ==========================================
# Choose your preferred AI provider: anthropic, openai, glm-5, or custom
AI_PROVIDER=anthropic

# Anthropic (Claude) - Default
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (GPT-4, GPT-3.5)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4

# GLM-5 (ZhipuAI)
# GLM5_API_KEY=your_glm5_api_key_here
# GLM5_MODEL=glm-4-plus
# GLM5_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# Custom AI Provider (OpenAI-compatible API)
# CUSTOM_AI_API_KEY=your_custom_api_key_here
# CUSTOM_AI_MODEL=your_model_name
# CUSTOM_AI_BASE_URL=https://your-api-endpoint.com

# ==========================================
# AUTHENTICATION (Discord OAuth)
# ==========================================
# Get these from: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# NextAuth Configuration
NEXTAUTH_SECRET=your_random_secret_string_here
NEXTAUTH_URL=https://your-domain.vercel.app

# ==========================================
# DATABASE
# ==========================================
# PostgreSQL connection string (Vercel Postgres, Supabase, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/database

# ==========================================
# FILE STORAGE (S3)
# ==========================================
# AWS S3 credentials for asset vault and story folders
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=your-vault-bucket-name
# AWS_REGION=us-east-1

# ==========================================
# INSTAGRAM API (for Feed Grid Simulator)
# ==========================================
# Instagram Graph API access token
# INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# ==========================================
# APPLICATION SETTINGS
# ==========================================
# Base URL for VA magic links and OAuth redirects
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app

# Story Generation Settings
# STORY_DAILY_COUNT=3
# STORY_REQUIRE_APPROVAL=true

# Auto-Scheduler Settings
# AUTO_SCHEDULE_MAX_DAYS=7
# AUTO_SCHEDULE_REQUIRE_APPROVAL=true

# ==========================================
# OPTIONAL: ANALYTICS & MONITORING
# ==========================================
# SENTRY_DSN=your_sentry_dsn
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
