# =============================================================================
# CreatorFlow — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================================================

# =============================================================================
# AI PROVIDER
# Set AI_PROVIDER to one of: anthropic | openai | gemini | grok | glm-5 | custom
# =============================================================================
AI_PROVIDER=anthropic

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# xAI Grok — https://console.x.ai
GROK_API_KEY=
GROK_MODEL=grok-3

# ZhipuAI GLM-5
GLM5_API_KEY=
GLM5_MODEL=glm-4-plus
GLM5_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# Custom OpenAI-compatible endpoint
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_BASE_URL=

# =============================================================================
# CLOUDFLARE R2 STORAGE (S3-compatible)
# Dashboard: https://dash.cloudflare.com → R2
# =============================================================================
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_TOKEN=
R2_BUCKET=social-scheduler

# =============================================================================
# META / INSTAGRAM GRAPH API
# App Dashboard: https://developers.facebook.com/apps
# =============================================================================
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_APP_ID=
META_APP_SECRET=

# Threads API (separate Meta app)
THREADS_APP_ID=

# =============================================================================
# DISCORD OAUTH (Authentication)
# Developer Portal: https://discord.com/developers/applications
# Add redirect URI: https://<your-domain>/api/auth/callback/discord
# =============================================================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# =============================================================================
# NEXTAUTH
# Generate secret: openssl rand -base64 32
# NEXTAUTH_URL must be your production URL on Vercel (no trailing slash)
# =============================================================================
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-app.vercel.app

# =============================================================================
# FANVUE OAUTH
# Dashboard: https://fanvue.com/developer
# =============================================================================
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
FANVUE_REDIRECT_URI=https://your-app.vercel.app/api/oauth/fanvue/callback
FANVUE_OAUTH_ISSUER=https://auth.fanvue.com

# =============================================================================
# APP
# =============================================================================
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
